{
  "name": "@cwa-dou/telekit-core",
  "version": "0.0.0",
  "description": "Shared schemas and operations for telekit (send Telegram messages).",
  "keywords": [
    "notifications",
    "telegram",
    "telekit"
  ],
  "homepage": "https://github.com/anhtudo97/telekit#readme",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhtudo97/telekit.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "pack:dry": "bun run build && bun pm pack --dry-run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}
